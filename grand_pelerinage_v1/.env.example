# =============================================================================
# CONFIGURATION DES SERVICES EXTERNES — LE GRAND PÈLERINAGE DE LA BIBLE
# =============================================================================

# 1. BREVO (EX-SENDINBLUE) — Envoi de courriels transactionnels
# Obtenez votre clé API SMTP/Transactionnelle sur : https://app.brevo.com/settings/keys/api
VITE_BREVO_API_KEY=
# Adresse d'expéditeur validée dans votre compte Brevo
VITE_BREVO_SENDER_EMAIL=contact@legrandpelerinage.fr
VITE_BREVO_SENDER_NAME=

# 2. FIREBASE AUTHENTIFICATION & FIRESTORE
# (Pré-rempli par défaut pour le projet defi-jean)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=1:

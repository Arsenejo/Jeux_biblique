rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Règles pour le classement mondial du Défi Jean
    match /classement_defi_jean/{joueurId} {
      // Tout le monde peut consulter le classement
      allow read: if true;

      // Tout joueur peut enregistrer ou mettre à jour son score
      allow create, update: if request.resource.data.pseudo is string
                            && request.resource.data.pseudo.size() >= 2
                            && request.resource.data.pseudo.size() <= 25
                            && request.resource.data.scoreTotal is number
                            && request.resource.data.scoreTotal >= 0
                            && request.resource.data.scoreTotal <= 100
                            && request.resource.data.etoilesTotal is number
                            && request.resource.data.etoilesTotal >= 0
                            && request.resource.data.etoilesTotal <= 30
                            && request.resource.data.niveauxDebloques is number
                            && request.resource.data.niveauxDebloques >= 1
                            && request.resource.data.niveauxDebloques <= 10;

      // Interdiction de suppression pour préserver l'historique
      allow delete: if false;
    }

    // =======================================================================
    // LE GRAND PÈLERINAGE DE LA BIBLE (RÈGLES DE SÉCURITÉ & VIE PRIVÉE)
    // =======================================================================

    // Profil du pèlerin : Lecture publique pour le classement fraternel,
    // modification STRICTEMENT réservée au propriétaire authentifié.
    match /pelerins/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.xp is number
                            && request.resource.data.xp >= 0
                            && request.resource.data.pearls is number
                            && request.resource.data.pearls >= 0;
      allow delete: if request.auth != null && request.auth.uid == uid;

      // CARNET SPIRITUEL PERSONNEL : STRICTEMENT PRIVÉ
      // Aucun pèlerin ne peut lire ou écrire dans le carnet intime d'un autre.
      match /carnet/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // MUR COMMUNAUTAIRE DE PRIÈRES & GRATITUDES
    // Contrôle d'accès, protection des données et signalement d'abus
    match /prieres/{prayerId} {
      // Lecture autorisée pour toute la communauté fraternelle
      allow read: if true;

      // Création réservée aux utilisateurs authentifiés avec validation de longueur
      allow create: if request.auth != null
                    && request.resource.data.texte is string
                    && request.resource.data.texte.size() >= 5
                    && request.resource.data.texte.size() <= 600
                    && request.resource.data.auteur is string
                    && request.resource.data.auteur.size() >= 2
                    && request.resource.data.auteur.size() <= 40
                    && request.resource.data.soutiens is number
                    && request.resource.data.soutiens >= 0;

      // Mise à jour restreinte : uniquement pour soutenir (« Je prie avec toi »)
      // ou pour signaler un abus, SANS pouvoir modifier le texte d'origine d'autrui
      allow update: if request.auth != null
                    && (
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['soutiens'])
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signaux', 'masque'])
                    );

      // Suppression réservée à l'auteur de l'intention
      allow delete: if request.auth != null
                    && resource.data.auteurId == request.auth.uid;
    }
  }
}

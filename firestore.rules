rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Plafonds alignés sur src/services/progression.js :
    // 150 XP et 5 perles par étape validée, bonus de révision 8000 / 500, 400 étapes max.

    function stageCountOk(n) {
      return n is int && n >= 0 && n <= 400;
    }

    function scoreWithinCeiling(xp, pearls, stages) {
      return xp is number && pearls is number
        && xp >= 0 && pearls >= 0
        && stageCountOk(stages)
        && xp <= stages * 150 + 8000
        && pearls <= stages * 5 + 500;
    }

    match /classement_defi_jean/{joueurId} {
      allow read: if true;
      allow create, update: if request.resource.data.pseudo is string
                            && request.resource.data.pseudo.size() >= 2
                            && request.resource.data.pseudo.size() <= 25
                            && request.resource.data.scoreTotal is number
                            && request.resource.data.scoreTotal >= 0
                            && request.resource.data.scoreTotal <= 100
                            && request.resource.data.etoilesTotal is number
                            && request.resource.data.etoilesTotal >= 0
                            && request.resource.data.etoilesTotal <= 30
                            && request.resource.data.niveauxDebloques is number
                            && request.resource.data.niveauxDebloques >= 1
                            && request.resource.data.niveauxDebloques <= 10;
      allow delete: if false;
    }

    match /pelerins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && !('email' in request.resource.data)
                            && !('telephone' in request.resource.data)
                            && !('phone' in request.resource.data)
                            && (
                              !('xp' in request.resource.data)
                              || scoreWithinCeiling(
                                request.resource.data.xp,
                                request.resource.data.get('pearls', 0),
                                request.resource.data.get('saved', {}).get('completedStages', []).size()
                              )
                            );

      allow delete: if request.auth != null && request.auth.uid == uid;

      match /carnet/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /classement_pelerins/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.pseudo is string
                            && request.resource.data.pseudo.size() >= 2
                            && request.resource.data.pseudo.size() <= 30
                            && request.resource.data.stagesValidees is int
                            && scoreWithinCeiling(
                              request.resource.data.xp,
                              request.resource.data.pearls,
                              request.resource.data.stagesValidees
                            )
                            && !('email' in request.resource.data)
                            && !('telephone' in request.resource.data)
                            && !('phone' in request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /prieres/{prayerId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.auteurId == request.auth.uid
                    && request.resource.data.texte is string
                    && request.resource.data.texte.size() >= 5
                    && request.resource.data.texte.size() <= 600
                    && request.resource.data.auteur is string
                    && request.resource.data.auteur.size() >= 2
                    && request.resource.data.auteur.size() <= 40
                    && request.resource.data.soutiens == 1
                    && request.resource.data.signaux == 0
                    && request.resource.data.masque == false
                    && !('email' in request.resource.data)
                    && !('telephone' in request.resource.data);
      allow update: if request.auth != null
                    && (
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['soutiens'])
                        && request.resource.data.soutiens == resource.data.soutiens + 1
                      )
                      || (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signaux', 'masque'])
                        && request.resource.data.signaux == resource.data.signaux + 1
                        && request.resource.data.masque == (request.resource.data.signaux >= 3)
                      )
                    );
      allow delete: if request.auth != null
                    && resource.data.auteurId == request.auth.uid;
    }

    match /pseudos_enregistres/{cleanPseudo} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.cleanPseudo == cleanPseudo
                    && request.resource.data.cleanPseudo is string
                    && request.resource.data.cleanPseudo.size() >= 2
                    && request.resource.data.cleanPseudo.size() <= 30;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
